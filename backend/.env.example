# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://movie_review_platform:movie_review_platform@localhost:5433/movie_review_platform?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# JWT
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# TMDB
TMDB_API_KEY=your-tmdb-v3-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_CACHE_TTL_SECONDS=86400

# Logging
LOG_LEVEL=debug

# E-posta (SMTP) — boş bırakılırsa e-postalar gönderilmez, konsola loglanır
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cinephiles <no-reply@cinephiles.local>

# Şifre sıfırlama
PASSWORD_RESET_TTL_MINUTES=60
